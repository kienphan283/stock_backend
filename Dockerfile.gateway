# Gateway Service (Node.js/Express)
# Build context: stock_backend/ (repo root)
FROM node:18-alpine

WORKDIR /app

# Copy package files
COPY services/gateway-service/package*.json ./

# Install all dependencies (including devDeps for TypeScript build)
RUN npm install

# Copy source code
COPY services/gateway-service/ .

# Build TypeScript
RUN npm run build

# Remove dev dependencies after build
RUN npm prune --production

EXPOSE 5000

CMD ["node", "dist/index.js"]
