# Market API Service (FastAPI)
# Build context: stock_backend/ (repo root)
FROM python:3.11-slim

WORKDIR /app

ENV PYTHONPATH="/app"

# Install dependencies
COPY services/market-api-service/requirements.txt .
RUN pip install --no-cache-dir --default-timeout=300 -r requirements.txt

# Copy service code
COPY services/market-api-service/ .

# Copy shared modules
COPY shared/ ./shared/

EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
